		annotation SummarizationSetBy = Automatic

	column weekend =
			
			IF(
			    Dim_calendar[Day of week] = 6 ||
			    Dim_calendar[Day of week] = 7,
			    "weekend",
			    "weekday")
		lineageTag: 307a17be-b95e-4086-94bb-2dd096526271
		summarizeBy: none

