	partition Dim_calendar = m
		mode: import
		source =
				let
				    Source = MySQL.Database(ServerName, DataBaseName, [ReturnSingleDatabase=true]),
				    bikevista_dev_calendar = Source{[Schema=DataBaseName,Item="calendar"]}[Data],
				    #"Removed Other Columns" = Table.SelectColumns(bikevista_dev_calendar,{"Date"}),
				    #"Inserted Day Name" = Table.AddColumn(#"Removed Other Columns", "Day Name", each Date.DayOfWeekName([Date]), type text),
				    #"Inserted Start of Week" = Table.AddColumn(#"Inserted Day Name", "Start of Week", each Date.StartOfWeek([Date],1)),
				    #"Inserted Start of Month" = Table.AddColumn(#"Inserted Start of Week", "Start of Month", each Date.StartOfMonth([Date]), type date),
				    #"Inserted Start of Quarter" = Table.AddColumn(#"Inserted Start of Month", "Start of Quarter", each Date.StartOfQuarter([Date]), type date),
				    #"Changed Type with Locale" = Table.TransformColumnTypes(#"Inserted Start of Quarter", {{"Date", type date}}, "en-US"),
				    #"Inserted Month Name" = Table.AddColumn(#"Changed Type with Locale", "Month Name", each Date.MonthName([Date]), type text),
				    #"Inserted Month" = Table.AddColumn(#"Inserted Month Name", "Month", each Date.Month([Date]), Int64.Type),
				    #"Inserted Start of Year" = Table.AddColumn(#"Inserted Month", "Start of Year", each Date.StartOfYear([Date]), type date),
				    #"Inserted Year" = Table.AddColumn(#"Inserted Start of Year", "Year", each Date.Year([Date]), Int64.Type),
				    #"Reordered Columns" = Table.ReorderColumns(#"Inserted Year",{"Date", "Day Name", "Month Name", "Month", "Year", "Start of Week", "Start of Month", "Start of Quarter", "Start of Year"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Reordered Columns",{{"Start of Week", type date}})
				in
