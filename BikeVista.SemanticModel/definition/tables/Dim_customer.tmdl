	column 'Customer priority' =
			
			IF(
			    Dim_customer[Parent]="Yes" && Dim_customer[AnnualIncome]>100000,
			    "Priority",
			    "Standard"
			)
		lineageTag: f956f838-dfed-4eff-b484-e9ee693fd91d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Parent =
			
			IF(
			    Dim_customer[TotalChildren]>0,
			    "Yes",
			    "No"
			)
		lineageTag: 45cefa63-fbbc-466f-b218-096aae0f0736
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Income level' =
			
			SWITCH(
			    TRUE(),
			    Dim_customer[AnnualIncome]>150000,"Very high",
			    Dim_customer[AnnualIncome]>100000,"High",
			    Dim_customer[AnnualIncome]>50000,"Average",
			    "Low"
			)
		lineageTag: bcfef5e8-35e0-4236-ac8b-6ca3fd2803d6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Education category' =
			
			SWITCH(
			    TRUE(),
			    Dim_customer[EducationLevel] = "High School" ||Dim_customer[EducationLevel] = "Partial High School","High School",
			    Dim_customer[EducationLevel] = "Bachelors" || Dim_customer[EducationLevel] = "Partial College","Undergrad",
			    "Graduated"
			)
		lineageTag: 367e1a61-918e-4e0c-b299-98163fce1a6c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Birth year' =
			
			YEAR(Dim_customer[BirthDate])
		formatString: 0
		lineageTag: 1faa8c65-0929-40ea-960d-d345c4f189ba
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

