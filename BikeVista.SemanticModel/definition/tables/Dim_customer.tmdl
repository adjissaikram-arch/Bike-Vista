				    #"Inserted Text Between Delimiters" = Table.AddColumn(#"Capitalized Each Word", "Text Between Delimiters", each Text.BetweenDelimiters([EmailAddress], "@", "."), type text),
				    #"Replaced Value" = Table.ReplaceValue(#"Inserted Text Between Delimiters","-"," ",Replacer.ReplaceText,{"Text Between Delimiters"}),
